<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 框架期即需要：更新通道 / 插件索引拉取 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- APK 插件安装与宿主自更新（PackageInstaller 提交；未知来源安装由
         系统确认页授权，网关自动转发 STATUS_PENDING_USER_ACTION 的确认意图） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 应用管理器：全量应用列表（targetSdk 28 不强制，Android 11+ 部分
         OEM 过滤行为下保持稳定；侧载分发不受 Play 政策审查约束） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 灵动岛悬浮球：WindowManager TYPE_APPLICATION_OVERLAY（特殊授权，
         经 Settings.canDrawOverlays 引导，无运行时弹窗） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 二维码工坊：API 26-28 保存到公共相册（API 29+ 走 MediaStore 免权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 定位伪装：前台服务持续供给测试坐标（targetSdk 28 同 Termux 语义，
         无 FGS type 强制） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- ARC-011（v0.10.2）：Dhizuku 公开 API 通道声明（Dhizuku-API AAR 自带
         API 权限，API_V2 由管理器校验）—— 只用 init / isPermissionGranted /
         requestPermission 三个公开方法，设备所有者交叉验证走 DPM。 -->
    <uses-permission android:name="com.rosan.dhizuku.permission.API" />
    <uses-permission android:name="com.rosan.dhizuku.permission.API_V2" />

    <!-- 定位伪装「以当前位置为基准」（可选授权，新手引导第三步） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Shizuku 兼容变体可见性（targetSdk 28 暂不受限，预留给未来升 target）：
         官方包名同时也是 Shevery / Shizuku-Next 等 fork 服务端 stub 的共用
         包名（替换安装关系）；Shevery / Shizuku+ 另有独立管理器 App。 -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
        <package android:name="com.hamondev.shevery" />
        <package android:name="af.shizuku.plus.api" />
        <package android:name="rikka.sui" />
        <!-- ARC-011：Dhizuku 提供端（原版 Dhizuku；Shevery 已在上表）—— 提供端
             是否为设备所有者由 DevicePolicyManager.isDeviceOwnerApp 交叉验证。 -->
        <package android:name="com.rosan.dhizuku" />
    </queries>

    <!-- allowBackup=false：伪装配置 / 指令历史 / 蓝图脚本不进云备份域
         （评审 #16：换机自动恢复「上次的伪装状态」既泄露隐私也可能直接生效） -->
    <application
        android:name=".AbyssApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Abyss">

        <!-- FEAT-036：桌面图标三选一（activity-alias 互斥启停）—— MainActivity
             自身不再持有 LAUNCHER filter（别名接管，Activity 组件恒 enabled，
             exported=false 足够）。默认碧眼 .LauncherCyan enabled；绯眼/隐眼
             出厂 disabled，由 LauncherIconGateway 运行时互斥启停
             （PackageManager + DONT_KILL_APP）。 -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity-alias
            android:name=".LauncherCyan"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherRed"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_red"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".LauncherBlue"
            android:targetActivity=".MainActivity"
            android:exported="true"
            android:enabled="false"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- 定位伪装引擎：mock_location 测试源注入（前台服务） -->
        <service
            android:name="com.abyss.tools.feature.disguise.LocationSpoofService"
            android:exported="false" />

        <!-- 电量伪装保持守护：周期重申 dumpsys battery 伪装值（前台服务） -->
        <service
            android:name="com.abyss.tools.feature.disguise.BatteryGuardService"
            android:exported="false" />

        <!-- 状态栏信号显示伪装：TYPE_APPLICATION_OVERLAY 覆盖层（前台服务，
             悬浮窗授权经 Shizuku appops 或系统设置页） -->
        <service
            android:name="com.abyss.tools.feature.disguise.SignalOverlayService"
            android:exported="false" />

        <!-- ARC-011 / FEAT-040（v0.10.2）：无障碍服务 —— 只做前台包名感知 +
             手势代点两类原语；isAccessibilityTool=false 如实声明（冒称会被
             设备保护机制拦截），不申请 canRetrieveWindowContent。配置见
             res/xml/accessibility_service_config.xml。 -->
        <service
            android:name=".privilege.AbyssAccessibilityService"
            android:exported="false"
            android:label="@string/accessibility_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- ARC-011 / N-DO-001 探测底座（v0.10.2）：零策略设备管理员接收器 ——
             只为 isAdminActive 提供真实查询对象；本阶段无任何设备策略动作。 -->
        <receiver
            android:name=".privilege.AbyssDeviceAdminReceiver"
            android:exported="false"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- 统一 FileProvider：应用管理器（提取 APK 分享）与二维码工坊
             （PNG 分享）共用，路径映射见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.abyss.tools.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ════════════════════════════════════════════════════════════
             ShizukuProvider —— v0.7.0 闪退修复（P0）：
             dev.rikka.shizuku:provider 13.1.5 的 AAR 清单【只携带
             V3_SUPPORT meta-data 与 API_V23 权限，不含 provider 声明】
             （上游设计：宿主必须自行声明）。此前版本漏声明导致 Shizuku
             binder 永远收不到 —— 伪装四件套（机型/电量/信号/定位）在
             已发布版本上全部实际不可用，且部分机型首启请求 binder 时
             ContentResolver 抛 IllegalArgumentException 叠加成闪退。
             ══════════════════════════════════════════════════════════ -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
