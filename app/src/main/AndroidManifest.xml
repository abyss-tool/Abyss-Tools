<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 框架期即需要：更新通道 / 插件索引拉取 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- APK 插件安装与宿主自更新（PackageInstaller 提交；未知来源安装由
         系统确认页授权，网关自动转发 STATUS_PENDING_USER_ACTION 的确认意图） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 应用管理器：全量应用列表（targetSdk 28 不强制，Android 11+ 部分
         OEM 过滤行为下保持稳定；侧载分发不受 Play 政策审查约束） -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <!-- 灵动岛悬浮球：WindowManager TYPE_APPLICATION_OVERLAY（特殊授权，
         经 Settings.canDrawOverlays 引导，无运行时弹窗） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- 二维码工坊：API 26-28 保存到公共相册（API 29+ 走 MediaStore 免权限） -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- 定位伪装：前台服务持续供给测试坐标（targetSdk 28 同 Termux 语义，
         无 FGS type 强制） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- 定位伪装「以当前位置为基准」（可选授权，新手引导第三步） -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Shizuku 可见性（targetSdk 28 暂不受限，预留给未来升 target） -->
    <queries>
        <package android:name="moe.shizuku.privileged.api" />
    </queries>

    <!-- allowBackup=false：伪装配置 / 指令历史 / 蓝图脚本不进云备份域
         （评审 #16：换机自动恢复「上次的伪装状态」既泄露隐私也可能直接生效） -->
    <application
        android:name=".AbyssApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Abyss">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 定位伪装引擎：mock_location 测试源注入（前台服务） -->
        <service
            android:name="com.abyss.tools.feature.disguise.LocationSpoofService"
            android:exported="false" />

        <!-- 电量伪装保持守护：周期重申 dumpsys battery 伪装值（前台服务） -->
        <service
            android:name="com.abyss.tools.feature.disguise.BatteryGuardService"
            android:exported="false" />

        <!-- 状态栏信号显示伪装：TYPE_APPLICATION_OVERLAY 覆盖层（前台服务，
             悬浮窗授权经 Shizuku appops 或系统设置页） -->
        <service
            android:name="com.abyss.tools.feature.disguise.SignalOverlayService"
            android:exported="false" />

        <!-- 统一 FileProvider：应用管理器（提取 APK 分享）与二维码工坊
             （PNG 分享）共用，路径映射见 res/xml/file_paths.xml -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.abyss.tools.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- ════════════════════════════════════════════════════════════
             ShizukuProvider —— v0.7.0 闪退修复（P0）：
             dev.rikka.shizuku:provider 13.1.5 的 AAR 清单【只携带
             V3_SUPPORT meta-data 与 API_V23 权限，不含 provider 声明】
             （上游设计：宿主必须自行声明）。此前版本漏声明导致 Shizuku
             binder 永远收不到 —— 伪装四件套（机型/电量/信号/定位）在
             已发布版本上全部实际不可用，且部分机型首启请求 binder 时
             ContentResolver 抛 IllegalArgumentException 叠加成闪退。
             ══════════════════════════════════════════════════════════ -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
